# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
#   cp .env.example .env
#
# Nothing in this repository reads os.environ directly; everything goes through
# ap_agent.config.Settings, so this file is the complete list of what the
# application can be configured with.

# --- Anthropic -------------------------------------------------------------
# Empty is valid for offline work: ingestion, indexing, and the whole test suite
# run without a key.
ANTHROPIC_API_KEY=

# Only needed if the key above is ORGANISATION-scoped rather than scoped to a
# workspace. An org-scoped key resolves no workspace of its own, and the API
# rejects the request with:
#
#   400 invalid_request_error - This API key is not scoped to a workspace, so
#   this request must include the anthropic-workspace-id header
#
# Fix it either way: paste the workspace id here (Console -> Settings ->
# Workspaces; it looks like wrkspc_...), or issue a new key from inside the
# workspace and leave this empty. Sending it with a workspace-scoped key would
# override that key's own workspace, so it is omitted when blank.
ANTHROPIC_WORKSPACE_ID=

# The two LLM seats. Extraction reads documents and has no tools; classification
# explains exceptions that deterministic code has already found, and is shown
# codes and numbers only - never document text.
EXTRACTION_MODEL=claude-sonnet-5

# The second reading, over the PDF text layer rather than the page image.
# Deliberately a different, cheaper model: two reads are only worth having if
# they can be wrong in different ways.
TEXT_EXTRACTION_MODEL=claude-haiku-4-5
CLASSIFICATION_MODEL=claude-sonnet-5

# --- Database --------------------------------------------------------------
# Two roles, on purpose. The application connects as an ordinary role so that the
# REVOKE making audit_events append-only actually binds; a superuser bypasses
# every privilege check and the control would be decorative. Migrations connect
# as the schema owner, which needs rights the application must not have.
# Both roles exist in the compose stack: see docker/initdb/010-app-role.sql.
DATABASE_URL=postgresql+psycopg://ap_agent_app:ap_agent_app@localhost:5432/ap_agent
DATABASE_MIGRATION_URL=postgresql+psycopg://ap_agent:ap_agent@localhost:5432/ap_agent

# --- Corpus ----------------------------------------------------------------
# Root of the git-ignored document tree. Nothing under it is ever committed.
DATA_DIR=data

# Goods receipts: what actually arrived against a purchase order. Owned by
# ap-agent because QuickBooks Online has no goods-receipt entity at all, which
# means the third leg of the three-way match has no home in the ERP. A setting
# rather than a literal so a past run can be replayed against the receipts as
# they stood at the time.
RECEIPTS_PATH=data/generated/receipts.json

# The one definition of a vendor: name, tax id, country and postal address.
# Committed and reviewable, unlike the corpus, because which supplier a name
# resolves to - and what country they are in, which decides how an ambiguous
# date is read - is a decision someone should be able to review in a diff.
VENDOR_MASTER_PATH=config/sandbox_vendor_master.yaml

# Token prices, versioned. Every model row in the audit trail records which
# version priced it, so a cost stays explainable after list prices change.
MODEL_PRICING_PATH=config/model_pricing.yaml

# Prompt versions, one per extraction seat. A prompt change is a new file and a
# new version, never an edit in place: an extraction from last month has to stay
# explainable under the prompt that produced it, so every older prompts/*.md
# stays on disk and any of them can be named here.
EXTRACTION_PROMPT_VERSION=extract_v2
TEXT_EXTRACTION_PROMPT_VERSION=extract_text_v2
CLASSIFICATION_PROMPT_VERSION=classify_v1

# --- ERP: QuickBooks Online ------------------------------------------------
# Sandbox only. There is no tool in this repository that moves money, so these
# credentials are used for reading POs and creating unpaid bills.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Seed value only. Intuit rotates the refresh token on EVERY refresh and forces
# the previous one to expire, so after the first call the live token lives in
# data/.qbo_tokens.json and this line goes stale. That is expected: the token
# manager prefers the file and falls back here only to bootstrap.
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox

# --- Guardrails ------------------------------------------------------------
# Versioned. A change means a new file, not an edit to this one.
GUARDRAILS_CONFIG_PATH=config/guardrails.v1.yaml

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
